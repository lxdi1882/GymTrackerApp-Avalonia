<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:GymTracker.Avalonia.Views"
             xmlns:m3c="using:Material3.Avalonia.Controls"
             xmlns:icons="using:Material3.Avalonia.Icons"
             x:Class="GymTracker.Avalonia.MainView"
             Background="{DynamicResource Md3SurfaceBrush}"
             Foreground="{DynamicResource Md3OnSurfaceBrush}">

    <Grid RowDefinitions="*,Auto">

        <!-- Pages (kept alive so a workout in progress survives tab switches) -->
        <Panel>
            <Border x:Name="HomeHost" Classes="page off">
                <views:HomeView x:Name="HomePage" />
            </Border>
            <Border x:Name="WorkoutHost" Classes="page off" IsVisible="False">
                <views:WorkoutView x:Name="WorkoutPage" />
            </Border>
            <Border x:Name="HistoryHost" Classes="page off" IsVisible="False">
                <views:HistoryView x:Name="HistoryPage" />
            </Border>
            <Border x:Name="ExercisesHost" Classes="page off" IsVisible="False">
                <views:ExercisesView x:Name="ExercisesPage" />
            </Border>
            <Border x:Name="SettingsHost" Classes="page off" IsVisible="False">
                <views:SettingsView x:Name="SettingsPage" />
            </Border>
        </Panel>

        <!-- Bottom nav: same background as the page, thin separator line on top -->
        <Border Grid.Row="1"
                Background="{DynamicResource Md3SurfaceBrush}"
                BorderBrush="{DynamicResource Md3OutlineVariantBrush}"
                BorderThickness="0,1,0,0">
            <m3c:NavigationBar x:Name="NavBar" SelectedIndex="0"
                                Height="58"
                               Background="{DynamicResource Md3SurfaceBrush}">
                <m3c:NavigationBarItem Label="Home" AutomationProperties.Name="Home">
                    <m3c:NavigationBarItem.Icon>
                        <PathIcon Data="{x:Static icons:MaterialSymbols.Home}" />
                    </m3c:NavigationBarItem.Icon>
                </m3c:NavigationBarItem>
                <m3c:NavigationBarItem Label="Workout" AutomationProperties.Name="Workout">
                    <m3c:NavigationBarItem.Icon>
                        <PathIcon Data="{x:Static icons:MaterialSymbols.FitnessCenter}" />
                    </m3c:NavigationBarItem.Icon>
                </m3c:NavigationBarItem>
                <m3c:NavigationBarItem Label="History" AutomationProperties.Name="History">
                    <m3c:NavigationBarItem.Icon>
                        <PathIcon Data="{x:Static icons:MaterialSymbols.History}" />
                    </m3c:NavigationBarItem.Icon>
                </m3c:NavigationBarItem>
                <m3c:NavigationBarItem Label="Exercises" AutomationProperties.Name="Exercises">
                    <m3c:NavigationBarItem.Icon>
                        <PathIcon Data="{x:Static icons:MaterialSymbols.FormatListBulleted}" />
                    </m3c:NavigationBarItem.Icon>
                </m3c:NavigationBarItem>
                <m3c:NavigationBarItem Label="Settings" AutomationProperties.Name="Settings">
                    <m3c:NavigationBarItem.Icon>
                        <PathIcon Data="{x:Static icons:MaterialSymbols.Settings}" />
                    </m3c:NavigationBarItem.Icon>
                </m3c:NavigationBarItem>
            </m3c:NavigationBar>
        </Border>
    </Grid>
</UserControl>