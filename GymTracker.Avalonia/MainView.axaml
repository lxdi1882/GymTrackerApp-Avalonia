<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:GymTracker.Avalonia.Views"
             x:Class="GymTracker.Avalonia.MainView"
             Background="{DynamicResource Surface}"
             Foreground="{DynamicResource OnSurface}">

    <Grid RowDefinitions="*,Auto">

        <!-- Pages (kept alive so a workout in progress survives tab switches) -->
        <Panel>
            <views:HomeView x:Name="HomePage" />
            <views:WorkoutView x:Name="WorkoutPage" IsVisible="False" />
            <views:HistoryView x:Name="HistoryPage" IsVisible="False" />
            <views:ExercisesView x:Name="ExercisesPage" IsVisible="False" />
            <views:SettingsView x:Name="SettingsPage" IsVisible="False" />
        </Panel>

        <!-- Bottom navigation bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceContainer}"
                BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <RadioButton x:Name="NavHome" Classes="nav" GroupName="nav" IsChecked="True"
                             Tag="Home" AutomationProperties.Name="Home">
                    <PathIcon Data="{StaticResource IconHome}" Width="24" Height="24" />
                </RadioButton>
                <RadioButton x:Name="NavWorkout" Grid.Column="1" Classes="nav" GroupName="nav"
                             Tag="Workout" AutomationProperties.Name="Workout">
                    <PathIcon Data="{StaticResource IconWorkout}" Width="24" Height="24" />
                </RadioButton>
                <RadioButton x:Name="NavHistory" Grid.Column="2" Classes="nav" GroupName="nav"
                             Tag="History" AutomationProperties.Name="History">
                    <PathIcon Data="{StaticResource IconHistory}" Width="24" Height="24" />
                </RadioButton>
                <RadioButton x:Name="NavExercises" Grid.Column="3" Classes="nav" GroupName="nav"
                             Tag="Exercises" AutomationProperties.Name="Exercises">
                    <PathIcon Data="{StaticResource IconExercises}" Width="24" Height="24" />
                </RadioButton>
                <RadioButton x:Name="NavSettings" Grid.Column="4" Classes="nav" GroupName="nav"
                             Tag="Settings" AutomationProperties.Name="Settings">
                    <PathIcon Data="{StaticResource IconSettings}" Width="24" Height="24" />
                </RadioButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
