<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:GymTracker.Avalonia.Models"
             x:Class="GymTracker.Avalonia.Views.HomeView">

    <ScrollViewer>
        <StackPanel Margin="24,28,24,24" Spacing="32" MaxWidth="640">

            <!-- Header -->
            <StackPanel Spacing="2">
                <TextBlock x:Name="DateText" Classes="muted" />
                <TextBlock Text="Ready to train?" FontSize="28" FontWeight="Bold" />
            </StackPanel>

            <!-- Weekly streak: plain surface, no card -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock x:Name="StreakText" Text="0" FontSize="80" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Accent}" />
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,16">
                        <TextBlock Text="week streak" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StreakHint" Classes="muted" VerticalAlignment="Center" />
                            <PathIcon x:Name="GoalCheck" IsVisible="False" Width="16" Height="16"
                                      Foreground="{DynamicResource Accent}"
                                      Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Text="Weekly goal" Classes="muted" VerticalAlignment="Center" />
                    <Button x:Name="GoalMinus" Grid.Column="1" Classes="icon" Content="−"
                            AutomationProperties.Name="Decrease weekly goal" />
                    <TextBlock x:Name="GoalValue" Grid.Column="2" Text="3" FontSize="16" FontWeight="SemiBold"
                               Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="GoalPlus" Grid.Column="3" Classes="icon" Content="+"
                            AutomationProperties.Name="Increase weekly goal" />
                </Grid>
            </StackPanel>

            <Button x:Name="StartButton" Classes="primary" Content="Start workout" />

            <!-- Recent PRs -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Personal records" />
                <TextBlock x:Name="PrEmpty" Classes="muted" Text="No new records this week. Go set one." />
                <ItemsControl x:Name="PrList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PrDisplay">
                            <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ExerciseName}" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{Binding ResultText}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Last workout: the one card on the page -->
            <StackPanel Spacing="12">
                <TextBlock Classes="section" Text="Last workout" />
                <TextBlock x:Name="LastEmpty" Classes="muted" Text="Nothing logged yet. Start your first workout." />
                <Border x:Name="LastCard" IsVisible="False" CornerRadius="16" Padding="20"
                        Background="{DynamicResource SurfaceContainer}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LastTitle" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="LastExercises" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock x:Name="LastMeta" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
