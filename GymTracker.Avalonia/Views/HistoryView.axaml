<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:GymTracker.Avalonia.Views"
             xmlns:models="using:GymTracker.Avalonia.Models"
             x:Class="GymTracker.Avalonia.Views.HistoryView">

    <ScrollViewer>
        <StackPanel Margin="24,28,24,24" Spacing="24" MaxWidth="640">

            <!-- Header -->
            <StackPanel Spacing="2">
                <TextBlock x:Name="SummaryText" Classes="muted" />
                <TextBlock Text="History" FontSize="28" FontWeight="Bold" />
            </StackPanel>

            <TextBlock x:Name="EmptyText" Classes="muted" IsVisible="False"
                       Text="No workouts yet. Finish one and it shows up here." />
            <TextBlock x:Name="ErrorText" IsVisible="False" FontSize="14"
                       Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" />

            <ItemsControl x:Name="SessionList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistorySession">
                        <Border CornerRadius="16" Background="{DynamicResource SurfaceContainer}">
                            <StackPanel>

                                <!-- Session header (tap to expand) -->
                                <Button Classes="flat" CornerRadius="16" Padding="20,16"
                                        Click="OnToggleSession" AutomationProperties.Name="Show or hide workout details">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Chevron}" Classes="muted"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Exercises (each expands to its sets) -->
                                <StackPanel IsVisible="{Binding IsExpanded}" Margin="20,0,20,12">
                                    <ItemsControl ItemsSource="{Binding Exercises}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ExerciseLogDisplay">
                                                <StackPanel>
                                                    <Border BorderBrush="{DynamicResource Outline}"
                                                            BorderThickness="0,1,0,0">
                                                        <Button Classes="flat" Padding="0,12"
                                                                Click="OnToggleExercise"
                                                                AutomationProperties.Name="Show or hide sets">
                                                            <Grid ColumnDefinitions="*,Auto,24">
                                                                <TextBlock Text="{Binding ExerciseName}" FontSize="15" />
                                                                <TextBlock Grid.Column="1" Text="{Binding SetCountText}"
                                                                           Classes="muted" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ChevronGlyph}"
                                                                           Classes="muted" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Button>
                                                    </Border>

                                                    <ItemsControl IsVisible="{Binding IsExpanded}"
                                                                  ItemsSource="{Binding SetLines}" Margin="0,0,0,8">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="sys:String">
                                                                <TextBlock Text="{Binding}" Classes="muted"
                                                                           Margin="0,3" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0"
                                            Margin="0,4,0,0" Padding="0,8,0,0">
                                        <Button Classes="danger" Content="{Binding DeleteLabel}"
                                                Click="OnDeleteSession" />
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
