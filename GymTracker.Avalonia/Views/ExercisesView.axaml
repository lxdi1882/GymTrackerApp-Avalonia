<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymTracker.Avalonia.Views"
             xmlns:models="using:GymTracker.Avalonia.Models"
             xmlns:m3c="using:Material3.Avalonia.Controls"
             x:Class="GymTracker.Avalonia.Views.ExercisesView">

    <!-- Scrim and DialogPane are in-place overlays: they cover this shared Panel -->
    <Panel>

        <ScrollViewer x:Name="Scroller">
            <StackPanel Margin="24,28,24,24" Spacing="24" MaxWidth="640">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CountText" Classes="muted" />
                        <TextBlock Text="Exercises" Classes="headline-medium" />
                    </StackPanel>
                    <Button x:Name="AddButton" Grid.Column="1" Classes="tonal" Content="Add new"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Search -->
                <TextBox x:Name="SearchBox" PlaceholderText="Search exercises" />

                <TextBlock x:Name="EmptyText" Classes="muted" IsVisible="False"
                           Text="No exercises match your search." />

                <!-- Muscle groups: tap to expand, rows are only built for opened groups -->
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExerciseGroup">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource Md3OutlineVariantBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Button Classes="text row" Click="OnToggleGroup" MinHeight="56"
                                            AutomationProperties.Name="{Binding Name}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Text="{Binding Name}" Classes="section"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Md3PrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted"
                                                       Margin="12,0" VerticalAlignment="Center" />
                                            <Panel Grid.Column="2" Width="24" Height="24">
                                                <PathIcon Width="24" Height="24" IsVisible="{Binding IsCollapsed}"
                                                          Foreground="{DynamicResource Md3OnSurfaceVariantBrush}"
                                                          Data="M16.59,8.59L12,13.17L7.41,8.59L6,10L12,16L18,10L16.59,8.59Z" />
                                                <PathIcon Width="24" Height="24" IsVisible="{Binding IsExpanded}"
                                                          Foreground="{DynamicResource Md3OnSurfaceVariantBrush}"
                                                          Data="M12,8L6,14L7.41,15.41L12,10.83L16.59,15.41L18,14L12,8Z" />
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </Border>

                                <ItemsControl Classes="reveal" Classes.open="{Binding IsExpanded}"
                                              ItemsSource="{Binding VisibleItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Exercise">
                                            <Border BorderBrush="{DynamicResource Md3OutlineVariantBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Button Classes="text row" Click="OnEditExercise"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontSize="16"
                                                                   TextWrapping="Wrap" Margin="12,0,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SubTarget}"
                                                                   Classes="muted" Margin="12,0"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Add / edit dialog (M3 DialogPane over an M3 Scrim) -->
        <m3c:Scrim x:Name="Scrim" IsOpen="False" />

        <m3c:DialogPane x:Name="FormPanel" Classes="dialog" Title="New exercise"
                        IsVisible="False" Margin="24" MaxWidth="440"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBox x:Name="NameBox" PlaceholderText="Name" />
                <ComboBox x:Name="GroupBox" PlaceholderText="Muscle group"
                          HorizontalAlignment="Stretch" />
                <TextBox x:Name="SubTargetBox" PlaceholderText="Target, like Upper or Lats (optional)" />
                <TextBlock x:Name="FormError" IsVisible="False" FontSize="14"
                           Foreground="{DynamicResource Md3ErrorBrush}" TextWrapping="Wrap" />
                <Button x:Name="DeleteButton" Classes="text danger" Content="Delete exercise"
                        IsVisible="False" HorizontalAlignment="Left" />
            </StackPanel>

            <m3c:DialogPane.Buttons>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Classes="text" Content="Cancel" />
                    <Button x:Name="SaveButton" Classes="text" Content="Save exercise" />
                </StackPanel>
            </m3c:DialogPane.Buttons>
        </m3c:DialogPane>

    </Panel>
</UserControl>