<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GymTracker.Avalonia.Views.SettingsView">

    <ScrollViewer>
        <StackPanel Margin="24,28,24,24" Spacing="28" MaxWidth="640">

            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />

            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="Training" Foreground="{DynamicResource Accent}" />

                <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Weekly goal" FontSize="16" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Training days per week to keep your streak" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="GoalMinus" Classes="tonal" Content="−" Width="44" Padding="0"
                                    FontSize="20" AutomationProperties.Name="Decrease weekly goal" />
                            <TextBlock x:Name="GoalValue" Text="3" Width="32" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" />
                            <Button x:Name="GoalPlus" Classes="tonal" Content="+" Width="44" Padding="0"
                                    FontSize="20" AutomationProperties.Name="Increase weekly goal" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" IsVisible="False" FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
