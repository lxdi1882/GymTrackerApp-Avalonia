<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3c="using:Material3.Avalonia.Controls"
             xmlns:icons="using:Material3.Avalonia.Icons"
             x:Class="GymTracker.Avalonia.Views.SettingsView">

    <ScrollViewer>
        <StackPanel Margin="24,28,24,24" Spacing="28" MaxWidth="640">

            <TextBlock Text="Settings" Classes="headline-medium" />

            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="Training" Foreground="{DynamicResource Md3PrimaryBrush}" />

                <Border BorderBrush="{DynamicResource Md3OutlineVariantBrush}" BorderThickness="0,0,0,1"
                        Padding="0,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Weekly goal" FontSize="16" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Training days per week to keep your streak" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <m3c:IconButton x:Name="GoalMinus" Variant="Tonal"
                                            AutomationProperties.Name="Decrease weekly goal">
                                <PathIcon Data="{x:Static icons:MaterialSymbols.Remove}" />
                            </m3c:IconButton>
                            <TextBlock x:Name="GoalValue" Text="3" Width="32" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Md3PrimaryBrush}" />
                            <m3c:IconButton x:Name="GoalPlus" Variant="Tonal"
                                            AutomationProperties.Name="Increase weekly goal">
                                <PathIcon Data="{x:Static icons:MaterialSymbols.Add}" />
                            </m3c:IconButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" IsVisible="False" FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource Md3ErrorBrush}" TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
