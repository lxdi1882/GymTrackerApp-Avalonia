<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GymTracker.Avalonia.Views"
        x:Class="GymTracker.Avalonia.MainWindow"
        Title="Gym Tracker"
        Width="420" Height="700" MinWidth="360" MinHeight="560"
        Background="{DynamicResource Surface}">

    <TabControl Background="{DynamicResource Surface}">
        <TabItem Header="Home">
            <views:HomeView />
        </TabItem>
        <TabItem Header="History">
            <TextBlock Text="History page goes here" Margin="20" />
        </TabItem>
    </TabControl>
</Window>
