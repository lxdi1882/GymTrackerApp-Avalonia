<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GymTracker.Avalonia"
        x:Class="GymTracker.Avalonia.MainWindow"
        Title="Gym Tracker"
        Width="420" Height="700">

    <TabControl>
        <TabItem Header="Home">
            <local:HomeView />
        </TabItem>
        <TabItem Header="History">
            <TextBlock Text="History page goes here" Margin="20" />
        </TabItem>
    </TabControl>
</Window>