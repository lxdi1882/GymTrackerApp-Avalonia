<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GymTracker.Avalonia.MainWindow"
        Title="Gym Tracker"
        Width="420" Height="700"
        Background="#0D0D0D">

    <TabControl>
        <TabItem Header="Home">
            <TextBlock Text="Home page goes here" Foreground="White" Margin="20" />
        </TabItem>
        <TabItem Header="History">
            <TextBlock Text="History page goes here" Foreground="White" Margin="20" />
        </TabItem>
    </TabControl>
</Window>