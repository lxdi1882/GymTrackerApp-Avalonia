<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="using:Material3.Avalonia"
             xmlns:m3c="using:Material3.Avalonia.Controls"
             x:Class="GymTracker.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- M3 motion curves. Things entering decelerate, things leaving accelerate,
             and plain state changes (colors, fills) use the standard curve.
             A transition with no Easing is LINEAR in Avalonia, which is what reads as stutter. -->
        <SplineEasing x:Key="EmphasizedDecelerate" X1="0.05" Y1="0.7" X2="0.1" Y2="1" />
        <SplineEasing x:Key="EmphasizedAccelerate" X1="0.3" Y1="0" X2="0.8" Y2="0.15" />
        <SplineEasing x:Key="StandardEasing" X1="0.2" Y1="0" X2="0" Y2="1" />
    </Application.Resources>

    <Application.Styles>
        <!-- Material 3 replaces FluentTheme. Do NOT add <FluentTheme /> back. -->
        <m3:MaterialTheme SeedColor="#C8F23D" SchemeVariant="Vibrant" />

        <!-- Shared text styles (colors come from the M3 palette) -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Tappable full-width row (used with Classes="text row") -->
        <Style Selector="Button.row">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
        </Style>

        <!-- Weekly progress segment -->
        <Style Selector="Border.seg">
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerHighestBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"
                                     Easing="{StaticResource StandardEasing}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.seg.filled">
            <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
        </Style>

        <!-- Bottom nav: no labels, so center the icon vertically -->
    <Style Selector="m3c|NavigationBarItem">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>

        <!-- ================= Motion (things the library doesn't do for you) ================= -->

        <!-- Page host: fades + rises into place when the "off" class is removed -->
        <Style Selector="Border.page">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.30"
                                      Easing="{StaticResource EmphasizedDecelerate}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.30"
                                                   Easing="{StaticResource EmphasizedDecelerate}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.page.off">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(18px)" />
        </Style>

        <!-- Dialog surface: same idea, slightly faster -->
        <Style Selector="m3c|DialogPane.dialog">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22"
                                      Easing="{StaticResource EmphasizedDecelerate}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"
                                                   Easing="{StaticResource EmphasizedDecelerate}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="m3c|DialogPane.dialog.off">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(28px)" />
        </Style>

        <!-- Bottom sheet: slides up + fades in when "off" is removed -->
        <Style Selector="Border.sheet">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28"
                                      Easing="{StaticResource EmphasizedDecelerate}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28"
                                                   Easing="{StaticResource EmphasizedDecelerate}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.sheet.off">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(48px)" />
        </Style>

        <!-- Inline panel (Workout "Save N exercises?"): fades + rises in instead of snapping.
             Show it with the "off" pose first, then drop "off" a frame later. -->
        <Style Selector="Border.pop">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"
                                      Easing="{StaticResource EmphasizedDecelerate}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"
                                                   Easing="{StaticResource EmphasizedDecelerate}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.pop.off">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(12px)" />
        </Style>

        <!-- Busy bar: a thin primary pill that pulses while async work runs.
             Only the "busy" class starts the animation, so a hidden bar costs nothing. -->
        <Style Selector="Border.busybar">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.busybar.busy">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Easing="{StaticResource StandardEasing}"
                           IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%" x:SetterTargetType="Control">
                        <Setter Property="Opacity" Value="0.25" />
                    </KeyFrame>
                    <KeyFrame Cue="100%" x:SetterTargetType="Control">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Picker list row, highlighted when selected -->
        <Style Selector="Border.pickrow">
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.pickrow.sel">
            <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerHighestBrush}" />
        </Style>

        <!-- Expanding content (Exercises groups): opacity only, no transform animators needed.
             Needs "anim" as well as "open": groups are rebuilt on every search keystroke, and
             without "anim" every rebuilt group replayed this fade and the list blinked while typing.
             "anim" is only set when you tap a group yourself. -->
        <Style Selector="ItemsControl.reveal.open.anim">
            <Style.Animations>
                <Animation Duration="0:0:0.24" Easing="{StaticResource EmphasizedDecelerate}" FillMode="Forward">
                    <KeyFrame Cue="0%" x:SetterTargetType="Control">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%" x:SetterTargetType="Control">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Collapsing a group: rows fade out first (quick, accelerating), then get removed -->
        <Style Selector="ItemsControl.reveal">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"
                                      Easing="{StaticResource EmphasizedAccelerate}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.reveal.closing">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </Application.Styles>
</Application>