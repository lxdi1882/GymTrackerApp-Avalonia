<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GymTracker.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- Shared text styles -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Primary button (filled accent) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
        </Style>

        <!-- Tonal button (secondary) -->
        <Style Selector="Button.tonal">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tonal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>
        <Style Selector="Button.tonal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>
        <Style Selector="Button.tonal:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
        </Style>

        <!-- Icon button -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>

        <!-- Flat button (tappable rows / accordion headers) -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        </Style>

        <!-- Bottom navigation item -->
        <Style Selector="RadioButton.nav">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="0,12,0,14">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <Border x:Name="Pill" Width="64" Height="32" CornerRadius="16"
                                    Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                                    HorizontalAlignment="Center">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                                    </Transitions>
                                </Border.Transitions>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="NavLabel" Text="{TemplateBinding Tag}" FontSize="12"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.nav /template/ TextBlock#NavLabel">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
        </Style>
        <Style Selector="RadioButton.nav:pointerover:not(:checked) /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
        </Style>
        <Style Selector="RadioButton.nav:focus-visible /template/ Border#Pill">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="RadioButton.nav:checked">
            <Setter Property="Foreground" Value="{DynamicResource OnNavPill}" />
        </Style>
        <Style Selector="RadioButton.nav:checked /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource NavPill}" />
        </Style>
        <Style Selector="RadioButton.nav:checked /template/ TextBlock#NavLabel">
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Weekly progress segment -->
        <Style Selector="Border.seg">
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.seg.filled">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Danger button (text style, for destructive actions) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Outline}" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <StreamGeometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</StreamGeometry>
            <StreamGeometry x:Key="IconWorkout">M3,9H5V15H3Z M5,7H8V17H5Z M8,11H16V13H8Z M16,7H19V17H16Z M19,9H21V15H19Z</StreamGeometry>
            <StreamGeometry x:Key="IconHistory">M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z</StreamGeometry>
            <StreamGeometry x:Key="IconExercises">M3,5H6V8H3Z M8,5H21V8H8Z M3,10.5H6V13.5H3Z M8,10.5H21V13.5H8Z M3,16H6V19H3Z M8,16H21V19H8Z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M3,7H21V9H3Z M14,5H17V11H14Z M3,15H21V17H3Z M7,13H10V19H7Z</StreamGeometry>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Surface" Color="#101114" />
                    <SolidColorBrush x:Key="SurfaceContainer" Color="#1B1D22" />
                    <SolidColorBrush x:Key="OnSurface" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="OnSurfaceMuted" Color="#9AA0A9" />
                    <SolidColorBrush x:Key="Outline" Color="#2A2D33" />
                    <SolidColorBrush x:Key="Accent" Color="#C8F23D" />
                    <SolidColorBrush x:Key="OnAccent" Color="#11140A" />
                    <SolidColorBrush x:Key="AccentHover" Color="#D6F76B" />
                    <SolidColorBrush x:Key="AccentPressed" Color="#B3DB2E" />
                    <SolidColorBrush x:Key="ErrorText" Color="#FF8A80" />
                    <SolidColorBrush x:Key="NavPill" Color="#2E3A0F" />
                    <SolidColorBrush x:Key="OnNavPill" Color="#C8F23D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Surface" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="SurfaceContainer" Color="#ECEEF2" />
                    <SolidColorBrush x:Key="OnSurface" Color="#14161A" />
                    <SolidColorBrush x:Key="OnSurfaceMuted" Color="#5B616B" />
                    <SolidColorBrush x:Key="Outline" Color="#D9DCE2" />
                    <SolidColorBrush x:Key="Accent" Color="#4F6A00" />
                    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentHover" Color="#617F00" />
                    <SolidColorBrush x:Key="AccentPressed" Color="#3F5500" />
                    <SolidColorBrush x:Key="ErrorText" Color="#B3261E" />
                    <SolidColorBrush x:Key="NavPill" Color="#DCE8B0" />
                    <SolidColorBrush x:Key="OnNavPill" Color="#2F4000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
