<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialTheme="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="GymTracker.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <materialTheme:MaterialTheme BaseTheme="Dark"
                                     PrimaryColor="Lime"
                                     SecondaryColor="Green" />
    </Application.Styles>
</Application>