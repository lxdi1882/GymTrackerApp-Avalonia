<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="using:Material3.Avalonia"
             xmlns:m3c="using:Material3.Avalonia.Controls"
             x:Class="GymTracker.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <!-- Material 3 replaces FluentTheme. Do NOT add <FluentTheme /> back. -->
        <m3:MaterialTheme SeedColor="#C8F23D" SchemeVariant="Vibrant" />

        <!-- Shared text styles (colors come from the M3 palette) -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Tappable full-width row (used with Classes="text row") -->
        <Style Selector="Button.row">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
        </Style>

        <!-- Weekly progress segment -->
        <Style Selector="Border.seg">
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerHighestBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.seg.filled">
            <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
        </Style>

        <!-- ================= Motion (things the library doesn't do for you) ================= -->

        <!-- Page host: fades + rises into place when the "off" class is removed -->
        <Style Selector="Border.page">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.30" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.30" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.page.off">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(18px)" />
        </Style>

        <!-- Dialog surface: same idea, slightly faster -->
        <Style Selector="m3c|DialogPane.dialog">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="m3c|DialogPane.dialog.off">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(28px)" />
        </Style>

        <!-- Expanding content (History accordions): opacity only, no transform animators needed -->
        <Style Selector=".reveal.open">
            <Style.Animations>
                <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%" x:SetterTargetType="Control">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%" x:SetterTargetType="Control">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
